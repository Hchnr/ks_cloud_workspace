#!/bin/sh
set -eu
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -z "${KS_CLOUD_PLAN:-}" ] && [ -f "$repo_dir/runs/active.json" ]; then
  exec "$repo_dir/bin/ks-cloud" monitor-dynamic --active "$repo_dir/runs/active.json" "$@"
fi
plan_path=${KS_CLOUD_PLAN:-"$repo_dir/runs/current/plan.json"}
if [ ! -f "$plan_path" ]; then
  echo "No plan found. Set KS_CLOUD_PLAN to your plan.json path." >&2
  exit 1
fi
exec "$repo_dir/bin/ks-cloud" monitor --plan "$plan_path" "$@"
